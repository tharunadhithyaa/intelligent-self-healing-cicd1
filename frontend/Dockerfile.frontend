# syntax=docker/dockerfile:1
# Build stage
FROM node:22-alpine AS builder

WORKDIR /app

# Perform OS security updates
RUN apk update && apk upgrade --no-cache

# Install dependencies first for better layer caching
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --prefer-offline --no-audit --no-fund

# Copy source code and build for production
COPY . .
RUN npm run build -- --configuration production

# Production stage
FROM nginx:1.27-alpine

# Perform OS security updates, upgrade libexpat/OS packages, and remove default nginx static assets
RUN apk update && apk upgrade --no-cache && \
    apk add --no-cache --upgrade expat libexpat || true && \
    rm -rf /usr/share/nginx/html/*

# Copy custom nginx configuration for frontend routing fallback
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy build artifacts from builder stage
COPY --from=builder /app/dist/frontend/browser /usr/share/nginx/html

# Add basic health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]