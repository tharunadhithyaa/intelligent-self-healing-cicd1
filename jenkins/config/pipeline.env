# ============================================================================
# CivicPulseAI — Pipeline Environment Configuration
# ============================================================================
# Centralized environment variables for the Jenkins CI/CD pipeline.
# Source this file in scripts: source jenkins/config/pipeline.env
# ============================================================================

# ── Project ───────────────────────────────────────────────────────────────────
PROJECT_NAME=CivicPulseAI
COMPOSE_PROJECT_NAME=civicpulse

# ── Docker Image Naming ──────────────────────────────────────────────────────
DOCKER_IMAGE_PREFIX=civicpulse
MONGODB_IMAGE=civicpulse/mongodb
BACKEND_IMAGE=civicpulse/backend
FRONTEND_IMAGE=civicpulse/frontend
NGINX_IMAGE=civicpulse/nginx

# ── Container Names ──────────────────────────────────────────────────────────
MONGODB_CONTAINER=civicpulse-mongodb
BACKEND_CONTAINER=civicpulse-backend
FRONTEND_CONTAINER=civicpulse-frontend
NGINX_CONTAINER=civicpulse-nginx

# ── Application URLs ─────────────────────────────────────────────────────────
APP_URL=http://localhost:30080/
BACKEND_URL=http://localhost:30080
MONGODB_URL=mongodb://localhost:27017

# ── Health Check Endpoints ────────────────────────────────────────────────────
BACKEND_HEALTH_ENDPOINT=/api/health
NGINX_HEALTH_ENDPOINT=/health
FRONTEND_HEALTH_ENDPOINT=/

# ── Health Check Tuning ───────────────────────────────────────────────────────
HEALTH_MAX_RETRIES=10
HEALTH_INTERVAL_SECONDS=15
STARTUP_WAIT_SECONDS=30
HTTP_TIMEOUT_SECONDS=10

# ── Ports ─────────────────────────────────────────────────────────────────────
NGINX_PORT=80
BACKEND_PORT=8000
FRONTEND_PORT=4200
MONGODB_PORT=27017

# ── Build Settings ────────────────────────────────────────────────────────────
PIPELINE_TIMEOUT_MINUTES=30
BUILD_IMAGES_TO_KEEP=5

# ── SonarQube Analysis & Quality Gate Settings ─────────────────────────────────
SONAR_PROJECT_KEY=intelligent-self-healing-cicd
SONAR_PROJECT_NAME=intelligent-self-healing-cicd
SONAR_SERVER_ENV=SonarQube
SONAR_QUALITY_GATE_TIMEOUT_MINUTES=5

# ── Trivy Vulnerability Scanner Settings ───────────────────────────────────────
TRIVY_SEVERITY=HIGH,CRITICAL
TRIVY_EXIT_CODE=1
TRIVY_REPORTS_DIR=jenkins/reports/trivy


