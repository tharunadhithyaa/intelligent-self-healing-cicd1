# ==============================================================================
# CivicPulse AI - Enterprise .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Security
# ------------------------------------------------------------------------------
# Never commit sensitive configurations or secrets!
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.trivyignore
*.pem
*.cert
*.crt
*.key
*.p12
*.pfx
*.pub
*secret*
!helm/civicpulse/templates/secret.yaml
!helm/**/secret.yaml
*credentials*
firebase-adminsdk.json
google-service-account.json
aws-credentials.csv

# ------------------------------------------------------------------------------
# 1.1 Helm & Kubernetes
# ------------------------------------------------------------------------------
helm/civicpulse/charts/
helm/civicpulse/Chart.lock
.helm/
kubeconfig
*.kubeconfig


